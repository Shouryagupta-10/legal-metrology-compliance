      setMfgDetails('PureRoots Plantations, Pollachi, Tamil Nadu - 642001');
      setUsp('0.60');
      setConsumerCareEmail('support@pureroots.in');
      setConsumerCarePhone('1800-425-9900');
      setHasTaxesIncluded(true);
    } else if (preset === 'missing_origin') {
