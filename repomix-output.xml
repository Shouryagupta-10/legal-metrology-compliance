  onOpenAssistant: () => void;
  theme: 'light' | 'dark';
  onToggleTheme: () => void;
}

export const FullscreenMenu: React.FC<FullscreenMenuProps> = ({
  isOpen,
  onClose,
  onSelectTab,
  onOpenAssistant,
  theme,
  onToggleTheme
}) => {
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) onClose();
